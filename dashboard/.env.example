# Copy to .env.local to override. Only VITE_* values reach the browser bundle: never put secrets here.
# The MandiCast API (its API_CORS_ORIGINS must include this dashboard's origin, http://localhost:5173 by default).
VITE_API_BASE=http://127.0.0.1:8000
# Docker Compose builds use VITE_API_BASE=same-origin: the dashboard's web server proxies /v1 to the API.
# Optional: the Telegram bot's username (without @), to link to it from the alerts page.
# VITE_BOT_USERNAME=
