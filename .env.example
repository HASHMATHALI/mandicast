# MandiCast configuration. Copy to `.env` (git-ignored) and fill in. Never commit real values.

# Personal API key for the Open Government Data Platform India (data.gov.in). Free.
# How to get it: sign in or register at https://www.data.gov.in, open "My Account", and copy or generate
# your API key. The portal's published sample key returns at most 10 records per call and is only for
# trying the API, so bulk ingestion needs your own key.
DATA_GOV_IN_API_KEY=

# Telegram bot token for the bot and price alerts (Phase 6). Without it, alerts are evaluated and queued but not sent.
# How to get it: in Telegram, message @BotFather, send /newbot, and follow the prompts. Treat it like a password:
# keep it only in this file (never in chat, code or commits); /revoke in @BotFather replaces it if it leaks.
TELEGRAM_BOT_TOKEN=
# Where the bot's one-time /login links point: the dashboard (Phase 7). Development server: http://localhost:5173;
# Docker Compose (default for the bot and worker containers): http://localhost:8090
# DASHBOARD_URL=http://localhost:5173

# Local PostgreSQL used by Docker Compose. Choose any strong password for your machine
# (e.g. python -c "import secrets; print(secrets.token_urlsafe(24))").
POSTGRES_USER=mandicast
POSTGRES_PASSWORD=
POSTGRES_DB=mandicast
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://mandicast:<password>@127.0.0.1:5433/mandicast

# Local Redis for API response caching and rate limits (Phase 4). Choose any strong password, as above.
REDIS_PASSWORD=
REDIS_PORT=6380
REDIS_URL=redis://:<password>@127.0.0.1:6380/0

# Password of the least-privilege database role used by the API and the bot (Phase 8, `mandicast db-roles`; Docker
# Compose creates the role). Any strong value of at least 16 characters, generated as above. Required by Compose.
API_DB_PASSWORD=

# API settings (optional; defaults shown)
# API_RATE_LIMIT_PER_MINUTE=60
# API_CORS_ORIGINS=http://localhost:5173
# API_TRUST_FORWARDED_FOR=false   # true only behind a reverse proxy you control (Compose sets it for its own proxy)
# DB_CONNECT_TIMEOUT_S=5          # give up on an unreachable database after this many seconds

# Docker Compose ports (all bound to 127.0.0.1; optional)
# DASHBOARD_PORT=8090
# MLFLOW_PORT=5000
# VITE_BOT_USERNAME=              # the bot's username, linked from the dashboard's alerts page
