# Secrets: copy .env.example to .env and fill it in; .env is never committed
.env
*.env
!.env.example

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/

# Data: raw downloads and the local database are rebuilt by the pipeline, not versioned
data/raw/
data/interim/
data/processed/
*.parquet
*.duckdb
*.sqlite

# Experiment tracking (large); exported reports under experiments/reports are committed
experiments/mlruns/
experiments/artifacts/
experiments/mlflow.db

# Run logs (JSON lines; secrets are redacted, but logs are runtime output)
logs/

# Trained serving models (rebuilt by `mandicast train-model`)
models/
# MLflow artifact copies of serving models (experiment mandicast-serving uses ./mlruns as artifact root)
mlruns/

# Database backups (personal data; kept locally, newest 7)
backups/
